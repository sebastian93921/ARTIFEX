# Docker deployment configuration: copy to .env.
# Compose builds ARTIFEX locally from this checkout.
ARTIFEX_LANGUAGE=en
POSTGRES_USER=artifex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artifex

# Set either/both LLM keys, or configure them later in the application.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTIFEX_LLM_PROVIDER=
ARTIFEX_LLM_MODEL=
ARTIFEX_LLM_BASE_URL=
ARTIFEX_LLM_PROXY=
