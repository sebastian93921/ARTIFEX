# Docker deployment configuration: copy to .env.
# Compose builds ARTEX locally from this checkout.
ARTEX_LANGUAGE=en
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# Set either/both LLM keys, or configure them later in the application.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
